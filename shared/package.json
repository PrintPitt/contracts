{
  "name": "@printpitt/shared",
  "version": "0.1.0",
  "description": "ABI, alamat deploy, dan helper bersama PrintPitt (contract FotokopiKilat + token tIDRX) untuk backend dan frontend",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
